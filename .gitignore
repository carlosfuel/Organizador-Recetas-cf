# Bytecode de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
.env/
.venv/

# Archivos de configuración del sistema operativo
.DS_Store
Thumbs.db

# Archivos de logs
*.log

# Archivos de bases de datos o temporales
*.sqlite3
*.db
*.bak
*.tmp

# Archivos generados por PyInstaller o similares (si se compila la app)
dist/
build/
*.spec

# Archivos de Qt Designer si se generan automáticamente
*.ui.py

# Configuración de IDEs/editors
.vscode/
.idea/
*.swp
*.swo

# Archivos de pruebas
.coverage
htmlcov/
.tox/
.nox/
.pytest_cache/

# Otros
*.egg-info/
.eggs/
*.pyd
*.so
*.dll

# Archivos de traducción generados
*.qm
*.ts~

# Configuración específica de pip o entorno
pip-log.txt
